# ============================================================
# easyTech - Variables d'environnement pour Vercel
# ============================================================
# Copier ce fichier vers .env.local pour le développement local
# Configurer ces mêmes variables dans Vercel Dashboard > Settings > Environment Variables
#
# RÈGLE ABSOLUE : ce fichier est publié. N'y écrire AUCUNE valeur réelle.
# Les clés ci-dessous sont des formats d'exemple ; les vrais secrets vivent
# dans Vercel (Production, type Sensitive) et dans .env.local, jamais suivis
# par git.
# ============================================================

# ============================================================
# SUPABASE (OBLIGATOIRE)
# ============================================================
# URL du projet (Settings > Data API), sans le /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-REFERENCE-PROJET.supabase.co

# Clé publishable (Settings > API Keys > Publishable key). Elle commence par
# sb_publishable_ et remplace l'ancienne clé `anon` : elle est faite pour être
# publique, mais elle ne peut que ce que la RLS autorise.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VOTRE_CLE_PUBLIABLE

# Clé secrète (Settings > API Keys > Secret key), préfixe sb_secret_. SECRET
# ABSOLU : serveur uniquement, jamais NEXT_PUBLIC_. Elle écrit les colonnes que
# le rôle client ne peut pas toucher (preuves de visionnage, scores, rôles).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_VOTRE_CLE_SECRETE

# ============================================================
# APPLICATION
# ============================================================
# URL publique de l'application (remplacer par l'URL Vercel finale)
NEXT_PUBLIC_SITE_URL=https://notre-domaine.vercel.app
NEXT_PUBLIC_APP_NAME=easyTech

# ============================================================
# PAIEMENT - NYOLE (Mobile Money + Carte)
# ============================================================
# Provider actif : "nyole" ou "mock". "mock" ne s'active qu'en développement :
# en production, la caisse refuse de simuler un paiement.
PAYMENT_PROVIDER=nyole

# Clés Nyole (Dashboard Nyole > API Keys)
NYOLE_SECRET_KEY=af_live_sec_VOTRE_CLE_SECRETE_ICI
NYOLE_PUBLIC_KEY=af_live_pub_VOTRE_CLE_PUBLIQUE_ICI

# URL du webhook Nyole (DOIT pointer vers votre domaine Vercel)
# Format: https://VOTRE_APP.vercel.app/api/webhooks/payment
NYOLE_WEBHOOK_URL=https://notre-domaine.vercel.app/api/webhooks/payment

# ============================================================
# EMAIL
# ============================================================
# Voie retenue : Brevo (300 e-mails/jour en gratuit), relais SMTP classique.
# Tableau de bord Brevo > ⚙️ > API & clés > SMTP & API : le « Login SMTP » et la
# « Clé SMTP » (variante Standard) vont dans SMTP_USER et SMTP_PASS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=LE-LOGIN-SMTP-BREVO
SMTP_PASS=LA-CLE-SMTP-BREVO
# L'expéditeur doit être un expéditeur confirmé chez Brevo, sinon le relais refuse.
EMAIL_FROM="easyTech <esaylearningrdc@gmail.com>"

# Secours : API Resend (Dashboard Resend > API Keys). L'adresse d'envoi doit
# être un domaine vérifié chez Resend, sinon les messages ne partent pas.
RESEND_API_KEY=re_VOTRE_CLE_RESEND_ICI

# Les réponses partent vers la boîte de src/config/contact.ts, l'unique adresse
# réellement dépouillée par l'équipe ; c'est aussi elle qui s'affiche sur le site.
# Le même compte Brevo sert aux e-mails d'inscription de Supabase Auth :
# Auth > SMTP, smtp-relay.brevo.com:587, mêmes login et clé.

# ============================================================
# SÉCURITÉ
# ============================================================
# Secret de signature des webhooks paiement : obligatoire, à générer
# (`openssl rand -hex 32`). La route refuse la valeur d'exemple publiée ici.
PAYMENT_WEBHOOK_SECRET=a_generer_avec_openssl_rand_hex_32

# Secret de signature des jetons d'évaluation (minuterie du quiz et de
# l'examen). Sans lui, la production refuse de démarrer une évaluation.
ASSESSMENT_SECRET=a_generer_avec_openssl_rand_hex_32

# Secret de la tâche périodique /api/cron/notices. Vercel l'injecte déjà dans
# l'en-tête Authorization de ses crons ; la valeur doit correspondre.
CRON_SECRET=a_generer_avec_openssl_rand_hex_32

# Comptes autorisés à déclencher le certificat de test, séparés par des
# virgules. Laisser vide désactive complètement la fonction.
CERTIFICATE_TEST_ACCOUNTS=

# ============================================================
# COURS LIVE (optionnel)
# ============================================================
# Salle vidéo autofugée : domaine Jitsi, sans schéma ni slash final.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ============================================================
# EXÉCUTION DE CODE (optionnel)
# ============================================================
# URL du service d'exécution de code (si utilisé)
# CODE_RUNNER_URL=https://votre-code-runner.example.com
# CODE_RUNNER_TOKEN=votre_token_secret
