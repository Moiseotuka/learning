# Clé publique anon (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdtZ21yeXd2bG9zenhscW1lbGx3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3MTk2NTYsImV4cCI6MjEwNjI5NTY1Nn0.RiBIzjqmygj0rEfsC0DZiMkVqKH9yse1yr1SyniW1TI

# Clé service role (Settings > API > Project API keys > service_role) - SECRET !
# NE JAMAIS mettre dans NEXT_PUBLIC_ ni exposer côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdtZ21yeXd2bG9zenhscW1lbGx3Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDcxOTY1NiwiZXhwIjoyMTA2Mjk1NjU2fQ.HES-GWE5j9MyRW3Ege3MQffJlAeZ9Jl8cM1foVxQFMk

# ============================================================
# APPLICATION
# ============================================================
# URL publique de l'application (remplacer par l'URL Vercel finale)
NEXT_PUBLIC_SITE_URL=https://easyTech.vercel.app
NEXT_PUBLIC_APP_NAME=easyTech

# ============================================================
# PAIEMENT - NYOLE (Mobile Money + Carte)
# ============================================================
# Provider actif : "nyole" ou "mock"
PAYMENT_PROVIDER=nyole

# Clés Nyole (Dashboard Nyole > API Keys)
NYOLE_SECRET_KEY=af_live_sec_VOTRE_CLE_SECRETE_ICI
NYOLE_PUBLIC_KEY=af_live_pub_VOTRE_CLE_PUBLIQUE_ICI

# URL du webhook Nyole (DOIT pointer vers votre domaine Vercel)
# Format: https://VOTRE_APP.vercel.app/api/webhooks/payment
NYOLE_WEBHOOK_URL=https://easyTech.vercel.app/api/webhooks/payment

# ============================================================
# EMAIL
# ============================================================
# Voie recommandée : la boîte de l'équipe, en mot de passe d'application SMTP.
# Google > Sécurité > Vérification en deux étapes > Mots de passe d'application.
# Ces trois variables, si elles sont présentes, passent devant Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=esaylearningrdc@gmail.com
SMTP_PASS=MOT_DE_PASSE_APPLICATION_GMAIL
# Envoi = SMTP_USER par défaut ; utile seulement pour un nom d'affichage autre.
EMAIL_FROM="easyTech <esaylearningrdc@gmail.com>"

# Secours : API Resend (Dashboard Resend > API Keys). L'adresse d'envoi doit
# être un domaine vérifié chez Resend, sinon les messages ne partent pas.
RESEND_API_KEY=re_VOTRE_CLE_RESEND_ICI

# Les réponses partent vers la boîte de src/config/contact.ts, l'unique adresse
# réellement dépouillée par l'équipe ; c'est aussi elle qui s'affiche sur le site.
# Les e-mails automatiques de Supabase (confirmation, réinitialisation) sont
# réglés dans Auth > SMTP, avec le même compte : voir scratch/setup-smtp.cjs.

# ============================================================
# EXÉCUTION DE CODE (optionnel)
# ============================================================
# URL du service d'exécution de code (si utilisé)
# CODE_RUNNER_URL=https://votre-code-runner.example.com
# CODE_RUNNER_TOKEN=votre_token_secret

# ============================================================
# SÉCURITÉ
# ============================================================
# Secret pour signer les webhooks paiement (generation obligatoire :
# `openssl rand -hex 32`). La route refuse la valeur d'exemple publiée ici.
PAYMENT_WEBHOOK_SECRET=a_generer_avec_openssl_rand_hex_32

# ============================================================
# DOMAINE PERSONNALISÉ (optionnel)
# ============================================================
# NEXT_PUBLIC_SITE_URL=https://easytech.cd
# NEXT_PUBLIC_APP_NAME=easyTech

# ============================================================
# INSTRUCTIONS VERCEL
# ============================================================
# 1. Allez sur https://vercel.com/dashboard
# 2. Importez le repo GitHub
# 2. Settings > Environment Variables
# 3. Ajoutez TOUTES les variables ci-dessus (Production + Preview + Development)
# 4. Déployez
# 5. Mettez à jour NYOLE_WEBHOOK_URL avec l'URL Vercel réelle après premier déploiement
# 6. Configurez le webhook Nyole dans le dashboard Nyole
# ============================================================