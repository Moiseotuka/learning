  "starter_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Atelier HTML du samedi — Médiathèque des Lilas</title>\n  <style>\n    /* TODO 1 : déclarer les variables de thème dans :root\n       --encre, --fond, --fond-doux, --accent, --accent-fonce,\n       --trait, --rayon, --espace, --mesure */\n\n    /* TODO 2 : dimensionnement à la bordure sur tous les éléments,\n       y compris ::before et ::after */\n\n    /* TODO 3 : base — police système, interligne lisible, texte pris dans\n       la variable d'encre ; corps de page à largeur bornée et centré */\n\n    /* TODO 4 : titres, paragraphes et listes sans marges parasite,\n       liens en couleur d'accent, titre principal en taille fluide avec clamp */\n\n    /* TODO 5 : grille de la page — grid-template-areas avec les zones\n       entete, menu, contenu, encart, pied, en une seule colonne */\n\n    /* TODO 6 : affecter chaque région à sa zone avec la propriété grid-area */\n\n    /* TODO 7 : navigation en flex — liens espacés, enroulement autorisé,\n       cible cliquable d'au moins 2.75rem et focus visible épais et décalé */\n\n    /* TODO 8 : composant carte — bordure, arrondi, espacement interne,\n       et liste de cartes fluide avec auto-fit et minmax */\n\n    /* TODO 9 : champ de formulaire et bouton principal pris aux variables,\n       état de survol et état de focus */\n\n    /* TODO 10 : media query (min-width: 56rem) — passer sur deux colonnes\n       et placer l'encart à droite du contenu */\n  </style>\n</head>\n<body>\n  <div class=\"page\">\n    <header class=\"entete\">\n      <h1>Atelier HTML du samedi</h1>\n      <p>Médiathèque des Lilas — samedi 18 octobre, de 14 h à 17 h</p>\n    </header>\n\n    <nav class=\"menu\" aria-label=\"Navigation principale\">\n      <ul>\n        <li><a href=\"index.html\">Accueil</a></li>\n        <li><a href=\"#programme\">Programme</a></li>\n        <li><a href=\"#inscription\">Inscription</a></li>\n      </ul>\n    </nav>\n\n    <main class=\"contenu\">\n      <article>\n        <h2>Trois heures pour écrire votre première page</h2>\n        <p>L'atelier ouvre à tout public débutant, sans prérequis technique.</p>\n\n        <ul class=\"cartes\">\n          <li class=\"carte\">\n            <h3>Ordinateur fourni</h3>\n            <p>Chacun dispose d'un poste en salle informatique.</p>\n          </li>\n          <li class=\"carte\">\n            <h3>Places limitées</h3>\n            <p>Douze participants au maximum, pour avancer à son rythme.</p>\n          </li>\n          <li class=\"carte\">\n            <h3>Entrée gratuite</h3>\n            <p>Sur inscription uniquement, dans la limite des places.</p>\n          </li>\n        </ul>\n\n        <section id=\"programme\">\n          <h3>Programme de la journée</h3>\n          <ol>\n            <li>14 h — Découvrir le squelette d'une page</li>\n            <li>14 h 30 — Écrire titres, listes, images et liens</li>\n            <li>16 h 30 — Construire un formulaire accessible</li>\n          </ol>\n        </section>\n\n        <section id=\"inscription\">\n          <h3>Inscription</h3>\n          <form action=\"/inscription\" method=\"post\">\n            <div class=\"champ\">\n              <label for=\"nom\">Nom complet</label>\n              <input type=\"text\" id=\"nom\" name=\"nom\" autocomplete=\"name\" required>\n            </div>\n            <div class=\"champ\">\n              <label for=\"courriel\">Adresse électronique</label>\n              <input type=\"email\" id=\"courriel\" name=\"courriel\" autocomplete=\"email\" required>\n            </div>\n            <button type=\"submit\" class=\"bouton\">Confirmer ma place</button>\n          </form>\n        </section>\n      </article>\n    </main>\n\n    <aside class=\"encart\">\n      <h3>Informations pratiques</h3>\n      <p>Salle 2, rez-de-chaussée, entrée ouest à côté du parking.</p>\n    </aside>\n\n    <footer class=\"pied\">\n      <p>© 2026 Médiathèque des Lilas — <a href=\"mentions.html\">Mentions légales</a></p>\n    </footer>\n  </div>\n</body>\n</html>",
  "solution_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Atelier HTML du samedi — Médiathèque des Lilas</title>\n  <style>\n    :root {\n      --encre: #1c1917;\n      --fond: #ffffff;\n      --fond-doux: #f5f5f4;\n      --accent: #0f766e;\n      --accent-fonce: #115e59;\n      --trait: #d6d3d1;\n      --rayon: 0.5rem;\n      --espace: 1.25rem;\n      --mesure: 62rem;\n    }\n\n    *,\n    *::before,\n    *::after { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      font-family: system-ui, sans-serif;\n      line-height: 1.6;\n      color: var(--encre);\n      background-color: var(--fond);\n    }\n\n    h1, h2, h3 { line-height: 1.2; margin: 0 0 0.5rem; }\n    h1 { font-size: clamp(1.75rem, 4vw + 1rem, 2.75rem); }\n    h2 { color: var(--accent); }\n    p, ul, ol { margin: 0 0 1rem; }\n    img { max-width: 100%; height: auto; display: block; }\n    a { color: var(--accent); }\n\n    .page {\n      display: grid;\n      grid-template-areas:\n        \"entete\"\n        \"menu\"\n        \"contenu\"\n        \"encart\"\n        \"pied\";\n      gap: var(--espace);\n      max-width: var(--mesure);\n      margin: 0 auto;\n      padding: clamp(1rem, 3vw, 2rem);\n    }\n\n    .entete { grid-area: entete; }\n    .menu { grid-area: menu; }\n    .contenu { grid-area: contenu; }\n    .encart { grid-area: encart; }\n    .pied { grid-area: pied; }\n\n    .menu ul {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem 1.5rem;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .menu a {\n      display: inline-block;\n      min-block-size: 2.75rem;\n      padding-inline: 0.5rem;\n      font-weight: 600;\n      text-decoration: none;\n      border-block-end: 2px solid transparent;\n    }\n\n    .menu a:hover { border-block-end-color: var(--accent); }\n\n    :where(a, button, input, textarea):focus-visible {\n      outline: 3px solid var(--accent);\n      outline-offset: 2px;\n    }\n\n    .cartes {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));\n      gap: 1rem;\n      padding: 0;\n      list-style: none;\n    }\n\n    .carte {\n      display: flex;\n      flex-direction: column;\n      padding: var(--espace);\n      border: 1px solid var(--trait);\n      border-radius: var(--rayon);\n      background-color: var(--fond);\n    }\n\n    .carte h3 { margin-block-start: 0; }\n    .carte p { margin-block-end: 0; flex-grow: 1; }\n\n    .champ { display: grid; gap: 0.35rem; margin-block-end: 1rem; }\n    .champ label { font-weight: 600; }\n\n    .champ input {\n      width: 100%;\n      padding: 0.6rem 0.75rem;\n      border: 1px solid var(--trait);\n      border-radius: var(--rayon);\n      font: inherit;\n      color: var(--encre);\n    }\n\n    .bouton {\n      padding: 0.6rem 1.1rem;\n      border: 2px solid var(--accent);\n      border-radius: var(--rayon);\n      background-color: var(--accent);\n      color: var(--fond);\n      font: inherit;\n      font-weight: 600;\n      cursor: pointer;\n    }\n\n    .bouton:hover { background-color: var(--accent-fonce); }\n\n    .encart {\n      padding: var(--espace);\n      border-radius: var(--rayon);\n      background-color: var(--fond-doux);\n    }\n\n    .pied {\n      padding-block-start: var(--espace);\n      border-block-start: 1px solid var(--trait);\n      font-size: 0.9rem;\n    }\n\n    @media (min-width: 56rem) {\n      .page {\n        grid-template-columns: minmax(0, 3fr) minmax(14rem, 1fr);\n        grid-template-areas:\n          \"entete entete\"\n          \"menu   menu\"\n          \"contenu encart\"\n          \"pied   pied\";\n        gap: 1.5rem 2rem;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page\">\n    <header class=\"entete\">\n      <h1>Atelier HTML du samedi</h1>\n      <p>Médiathèque des Lilas — samedi 18 octobre, de 14 h à 17 h</p>\n    </header>\n\n    <nav class=\"menu\" aria-label=\"Navigation principale\">\n      <ul>\n        <li><a href=\"index.html\">Accueil</a></li>\n        <li><a href=\"#programme\">Programme</a></li>\n        <li><a href=\"#inscription\">Inscription</a></li>\n      </ul>\n    </nav>\n\n    <main class=\"contenu\">\n      <article>\n        <h2>Trois heures pour écrire votre première page</h2>\n        <p>L'atelier ouvre à tout public débutant, sans prérequis technique.</p>\n\n        <ul class=\"cartes\">\n          <li class=\"carte\">\n            <h3>Ordinateur fourni</h3>\n            <p>Chacun dispose d'un poste en salle informatique.</p>\n          </li>\n          <li class=\"carte\">\n            <h3>Places limitées</h3>\n            <p>Douze participants au maximum, pour avancer à son rythme.</p>\n          </li>\n          <li class=\"carte\">\n            <h3>Entrée gratuite</h3>\n            <p>Sur inscription uniquement, dans la limite des places.</p>\n          </li>\n        </ul>\n\n        <section id=\"programme\">\n          <h3>Programme de la journée</h3>\n          <ol>\n            <li>14 h — Découvrir le squelette d'une page</li>\n            <li>14 h 30 — Écrire titres, listes, images et liens</li>\n            <li>16 h 30 — Construire un formulaire accessible</li>\n          </ol>\n        </section>\n\n        <section id=\"inscription\">\n          <h3>Inscription</h3>\n          <form action=\"/inscription\" method=\"post\">\n            <div class=\"champ\">\n              <label for=\"nom\">Nom complet</label>\n              <input type=\"text\" id=\"nom\" name=\"nom\" autocomplete=\"name\" required>\n            </div>\n            <div class=\"champ\">\n              <label for=\"courriel\">Adresse électronique</label>\n              <input type=\"email\" id=\"courriel\" name=\"courriel\" autocomplete=\"email\" required>\n            </div>\n            <button type=\"submit\" class=\"bouton\">Confirmer ma place</button>\n          </form>\n        </section>\n      </article>\n    </main>\n\n    <aside class=\"encart\">\n      <h3>Informations pratiques</h3>\n      <p>Salle 2, rez-de-chaussée, entrée ouest à côté du parking.</p>\n    </aside>\n\n    <footer class=\"pied\">\n      <p>© 2026 Médiathèque des Lilas — <a href=\"mentions.html\">Mentions légales</a></p>\n    </footer>\n  </div>\n</body>\n</html>",
  "concepts": [
