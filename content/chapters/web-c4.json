  "starter_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Inscriptions — Atelier de la Médiathèque des Lilas</title>\n  <style>\n    body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; color: #1f2933; }\n    h1 { font-size: 1.4rem; }\n    #etat { min-height: 1.4rem; color: #52606d; }\n    table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }\n    caption { caption-side: top; text-align: left; font-weight: 600; }\n    th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #d9e2ec; }\n    #reessayer { padding: 0.5rem 0.9rem; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <h1>Inscriptions aux séances</h1>\n  <p id=\"etat\">Prêt à charger les séances.</p>\n  <button id=\"reessayer\" hidden>Réessayer</button>\n\n  <table>\n    <caption>Séances ouvertes à l'inscription</caption>\n    <thead>\n      <tr>\n        <th scope=\"col\">Séance</th>\n        <th scope=\"col\">Date</th>\n        <th scope=\"col\">Places restantes</th>\n      </tr>\n    </thead>\n    <tbody id=\"corps\"></tbody>\n  </table>\n\n  <script type=\"module\">\n    const SEANCES = [\n      { id: \"S-101\", titre: \"Initiation HTML\", date: \"2026-10-17\", places: 12, inscrits: 9 },\n      { id: \"S-102\", titre: \"Mise en forme CSS\", date: \"2026-10-24\", places: 12, inscrits: 12 },\n      { id: \"S-103\", titre: \"Boucles et tableaux\", date: \"2026-11-07\", places: 10, inscrits: 4 },\n      { id: \"S-104\", titre: \"Fonctions et portée\", date: \"2026-11-14\", places: 10, inscrits: 0 }\n    ];\n\n    async function resolveAprès(ms, valeur) {\n      await new Promise((faire) => setTimeout(faire, ms));\n      return valeur;\n    }\n\n    const etat = { phase: \"chargement\", message: \"\", seances: [] };\n    const corps = document.getElementById(\"corps\");\n    const zoneEtat = document.getElementById(\"etat\");\n    const bouton = document.getElementById(\"reessayer\");\n\n    function formaterDate(iso) {\n      const [annee, mois, jour] = iso.split(\"-\");\n      return jour + \"/\" + mois + \"/\" + annee;\n    }\n\n    async function chargerInscriptions() {\n      etat.phase = \"chargement\";\n      etat.message = \"\";\n      dessiner();\n      try {\n        const brutes = await resolveAprès(600, SEANCES);\n        // TODO 1 : vérifier avec Array.isArray que brutes est bien un tableau, sinon throw\n        // TODO 2 : filtrer les séances dont toutes les places sont prises\n        // TODO 3 : mapper en objets d'affichage : libelle, jour, restantes, complet\n        etat.seances = brutes;\n        etat.phase = etat.seances.length === 0 ? \"vide\" : \"succes\";\n      } catch (erreur) {\n        // TODO 4 : passer en phase \"erreur\" et mémoriser erreur.message\n        etat.phase = \"erreur\";\n        etat.message = erreur.message;\n      }\n      dessiner();\n    }\n\n    function dessiner() {\n      // TODO 5 : vider corps puis écrire le message propre à etat.phase\n      // TODO 6 : en phase \"succes\", construire les lignes avec createElement et textContent\n      // TODO 7 : afficher le bouton réessayer uniquement en phase \"erreur\"\n      corps.replaceChildren();\n      bouton.hidden = true;\n      zoneEtat.textContent = \"Phase courante : \" + etat.phase + \" — complétez la fonction de rendu.\";\n    }\n\n    bouton.addEventListener(\"click\", () => {\n      // TODO 8 : relancer chargerInscriptions seulement si on n'est pas déjà en chargement\n    });\n\n    chargerInscriptions();\n  </script>\n</body>\n</html>",
  "solution_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Inscriptions — Atelier de la Médiathèque des Lilas</title>\n  <style>\n    body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; color: #1f2933; }\n    h1 { font-size: 1.4rem; }\n    #etat { min-height: 1.4rem; color: #52606d; }\n    #total { font-weight: 600; }\n    table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }\n    caption { caption-side: top; text-align: left; font-weight: 600; }\n    th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #d9e2ec; }\n    tbody tr.complet td:last-child { color: #9b1c1c; font-weight: 600; }\n    #reessayer { padding: 0.5rem 0.9rem; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <h1>Inscriptions aux séances</h1>\n  <p id=\"etat\">Chargement des séances...</p>\n  <p id=\"total\"></p>\n  <button id=\"reessayer\" hidden>Réessayer</button>\n\n  <table>\n    <caption>Séances ouvertes à l'inscription</caption>\n    <thead>\n      <tr>\n        <th scope=\"col\">Séance</th>\n        <th scope=\"col\">Date</th>\n        <th scope=\"col\">Places restantes</th>\n      </tr>\n    </thead>\n    <tbody id=\"corps\"></tbody>\n  </table>\n\n  <script type=\"module\">\n    const SEANCES = [\n      { id: \"S-101\", titre: \"Initiation HTML\", date: \"2026-10-17\", places: 12, inscrits: 9 },\n      { id: \"S-102\", titre: \"Mise en forme CSS\", date: \"2026-10-24\", places: 12, inscrits: 12 },\n      { id: \"S-103\", titre: \"Boucles et tableaux\", date: \"2026-11-07\", places: 10, inscrits: 4 },\n      { id: \"S-104\", titre: \"Fonctions et portée\", date: \"2026-11-14\", places: 10, inscrits: 0 },\n      { id: \"S-105\", titre: \"Premiers pas avec fetch\", date: \"2026-11-21\", places: 8, inscrits: 6 }\n    ];\n\n    async function resolveAprès(ms, valeur) {\n      await new Promise((faire) => setTimeout(faire, ms));\n      return valeur;\n    }\n\n    const etat = { phase: \"chargement\", message: \"\", seances: [], enCours: false };\n    const corps = document.getElementById(\"corps\");\n    const zoneEtat = document.getElementById(\"etat\");\n    const zoneTotal = document.getElementById(\"total\");\n    const bouton = document.getElementById(\"reessayer\");\n\n    function formaterDate(iso) {\n      const [annee, mois, jour] = iso.split(\"-\");\n      return jour + \"/\" + mois + \"/\" + annee;\n    }\n\n    async function chargerInscriptions() {\n      if (etat.enCours) {\n        return;\n      }\n      etat.enCours = true;\n      etat.phase = \"chargement\";\n      etat.message = \"\";\n      dessiner();\n      try {\n        const brutes = await resolveAprès(600, SEANCES);\n        if (!Array.isArray(brutes)) {\n          throw new Error(\"Format de liste inattendu\");\n        }\n        etat.seances = brutes\n          .filter((s) => s.inscrits < s.places)\n          .map((s) => ({\n            id: s.id,\n            libelle: s.titre,\n            jour: formaterDate(s.date),\n            restantes: s.places - s.inscrits,\n            complet: s.inscrits >= s.places\n          }));\n        etat.phase = etat.seances.length === 0 ? \"vide\" : \"succes\";\n      } catch (erreur) {\n        etat.phase = \"erreur\";\n        etat.message = erreur.message;\n      } finally {\n        etat.enCours = false;\n        dessiner();\n      }\n    }\n\n    function dessiner() {\n      corps.replaceChildren();\n\n      if (etat.phase === \"chargement\") {\n        zoneEtat.textContent = \"Chargement des séances...\";\n        zoneTotal.textContent = \"\";\n        bouton.hidden = true;\n        return;\n      }\n\n      if (etat.phase === \"erreur\") {\n        zoneEtat.textContent = \"Le chargement a échoué : \" + etat.message;\n        zoneTotal.textContent = \"\";\n        bouton.hidden = false;\n        return;\n      }\n\n      if (etat.phase === \"vide\") {\n        zoneEtat.textContent = \"Aucune séance ouverte pour le moment.\";\n        zoneTotal.textContent = \"\";\n        bouton.hidden = true;\n        return;\n      }\n\n      const restantes = etat.seances.reduce((somme, s) => somme + s.restantes, 0);\n      zoneEtat.textContent = etat.seances.length + \" séance(s) ouverte(s).\";\n      zoneTotal.textContent = \"Places restantes au total : \" + restantes;\n      bouton.hidden = true;\n\n      for (const seance of etat.seances) {\n        const ligne = document.createElement(\"tr\");\n        const valeurs = [seance.libelle, seance.jour, String(seance.restantes)];\n        valeurs.forEach((valeur, index) => {\n          const cellule = document.createElement(\"td\");\n          cellule.textContent = valeur;\n          if (index === 2) {\n            ligne.classList.toggle(\"complet\", seance.restantes === 0);\n          }\n          ligne.appendChild(cellule);\n        });\n        corps.appendChild(ligne);\n      }\n    }\n\n    bouton.addEventListener(\"click\", () => {\n      chargerInscriptions();\n    });\n\n    chargerInscriptions();\n  </script>\n</body>\n</html>",
