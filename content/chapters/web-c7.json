  "starter_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Atelier de la Médiathèque des Lilas — inscription</title>\n  <style>\n    :root { color-scheme: light; }\n    body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 0 auto; padding: 1.5rem; line-height: 1.5; color: #1b1b1f; }\n    nav ul { display: flex; gap: 1rem; list-style: none; padding: 0 0 0.75rem; margin: 0 0 1rem; border-bottom: 1px solid #d5d5dd; }\n    nav a { color: #2c2c86; text-decoration: none; }\n    nav a[aria-current=\"page\"] { font-weight: 700; text-decoration: underline; }\n    label { display: block; font-weight: 600; margin-top: 1rem; }\n    input { width: 100%; padding: 0.5rem; margin-top: 0.25rem; box-sizing: border-box; font: inherit; }\n    input[aria-invalid=\"true\"] { border: 2px solid #b00020; }\n    .erreur { color: #b00020; margin: 0.25rem 0 0; }\n    .succes { color: #0a6b2d; font-weight: 600; }\n    .etat { background: #f2f2f7; border-radius: 0.5rem; padding: 0.75rem 1rem; }\n    button { margin-top: 1rem; padding: 0.5rem 1rem; font: inherit; cursor: pointer; }\n    ul.inscrits { padding-left: 1.25rem; }\n    footer { margin-top: 2rem; border-top: 1px solid #d5d5dd; padding-top: 0.75rem; color: #55555f; font-size: 0.9rem; }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Atelier de la Médiathèque des Lilas</h1>\n    <nav aria-label=\"Navigation principale\">\n      <ul>\n        <li><a href=\"#/\" data-route=\"#/\">Accueil</a></li>\n        <li><a href=\"#/programme\" data-route=\"#/programme\">Programme</a></li>\n        <li><a href=\"#/inscription\" data-route=\"#/inscription\">Inscription</a></li>\n      </ul>\n    </nav>\n  </header>\n\n  <main id=\"app\"></main>\n\n  <footer>Inscription gratuite, samedi 18 octobre, salle 2.</footer>\n\n  <script>\n    /* ============================================================\n       1. ÉTAT GLOBAL\n       Parallèle React : un composant écrirait\n           const [valeurs, setValeurs] = useState({ nom: \"\", courriel: \"\" });\n       Ici il n'y a qu'un seul document : tout l'état tient dans un\n       objet unique que chaque fonction lit et modifie.\n       ============================================================ */\n    var etat = {\n      valeurs: { nom: \"\", courriel: \"\" },\n      erreurs: {},\n      statutEnvoi: \"repos\",        // repos | envoi | succès | echec\n      statutListe: \"chargement\",   // chargement | erreur | vide | succès\n      inscrits: [],\n      messageListe: \"\",\n      panneSimulee: false\n    };\n\n    // TODO (parallèle useState) : ajoutez ici les champs qui manquent à\n    // votre application, puis vérifiez qu'aucune fonction n'écrit jamais\n    // dans une variable qui échappe à cet objet.\n\n    var inscritsEnBase = [\n      { id: 1, nom: \"Amina Belkacem\", courriel: \"amina@exemple.fr\" },\n      { id: 2, nom: \"Marc Lefèvre\", courriel: \"marc@exemple.fr\" }\n    ];\n\n    /* ============================================================\n       2. LE MINI-CLIENT : deux fonctions qui résolvent localement,\n       sans réseau. Ce sont celles qu'un useEffect attendrait avec\n       await. Même nom, même forme : l'écran ignore la source.\n       ============================================================ */\n    function getInscrits() {\n      return new Promise(function (resolve, reject) {\n        setTimeout(function () {\n          if (etat.panneSimulee) reject(new Error(\"Service indisponible\"));\n          else resolve(inscritsEnBase.slice());\n        }, 400);\n      });\n    }\n\n    function postInscription(donnees) {\n      return new Promise(function (resolve, reject) {\n        setTimeout(function () {\n          if (!donnees.courriel || donnees.courriel.indexOf(\"@\") === -1) {\n            reject(new Error(\"Adresse refusée par le service.\"));\n          } else {\n            var inscription = {\n              id: inscritsEnBase.length + 1,\n              nom: donnees.nom,\n              courriel: donnees.courriel\n            };\n            inscritsEnBase.push(inscription);\n            resolve(inscription);\n          }\n        }, 300);\n      });\n    }\n\n    /* ============================================================\n       3. ROUTEUR PAR HASH\n       Parallèle React : <Routes> et <Route path=\"/programme\" />,\n       plus useNavigate(\"/inscription\") pour un déplacement programmé.\n       ============================================================ */\n    var routesConnues = [\"#/\", \"#/programme\", \"#/inscription\"];\n\n    function routeCourante() {\n      var hash = location.hash || \"#/\";\n      return routesConnues.indexOf(hash) === -1 ? \"#/introuvable\" : hash;\n    }\n\n    // TODO (parallèle useNavigate) : en React, cliquer sur un lien\n    // change l'adresse sans recharger le document et le routeur\n    // repeint l'écran tout seul. Ici, c'est l'événement \"hashchange\"\n    // qui joue ce rôle. Écrivez la fonction allerA(hash) qui écrit\n    // location.hash : c'est l'équivalent exact de navigate().\n    window.addEventListener(\"hashchange\", rendreEtLier);\n\n    /* ============================================================\n       4. VALIDATION\n       Parallèle React : fonction pure rappelée à la soumission,\n       puis gardée active tant que le formulaire reste invalide.\n       ============================================================ */\n    function valider(valeurs) {\n      var erreurs = {};\n      // TODO : nom d'au moins deux caractères ; courriel contenant \"@\"\n      // et un point après \"@\". Posez le message dans erreurs.nom et\n      // erreurs.courriel, phrase prête à être affichée.\n      return erreurs;\n    }\n\n    /* ============================================================\n       5. CHARGEMENT AU MONTAGE DE LA PAGE D'ACCUEIL\n       Parallèle React :\n           useEffect(function () { ... }, []);\n       Le tableau de dépendances vide signifie « une seule fois, à\n       l'arrivée ». Le drapeau ignore joue le rôle de la fonction de\n       nettoyage : une réponse venue après un nouveau clic est refusée.\n       ============================================================ */\n    function chargerInscrits() {\n      // TODO : posez chargementEnCours à true et statutListe à\n      // \"chargement\", puis appelez getInscrits(). En cas de réussite,\n      // remettez chargementEnCours à false, enregistrez la liste et\n      // choisissez le statut \"succès\" (liste non vide) ou \"vide\" ; en\n      // cas d'échec, remettez chargementEnCours à false et posez le\n      // statut \"erreur\". Terminez chaque branche par un appel à\n      // rendre(). Le drapeau ignore du chapitre se retrouve ici :\n      // une réponse arrivant après une nouvelle requête est refusée.\n    }\n\n    /* ============================================================\n       6. RENDU : une fonction par route, un seul point d'entrée.\n       Parallèle React : le composant rendu dépend de l'adresse.\n       ============================================================ */\n    var app = document.getElementById(\"app\");\n    var routePrecedente = null;\n    var chargementEnCours = false;\n\n    function echecHTML(cle) {\n      var message = etat.erreurs[cle];\n      if (!message) return \"\";\n      return '<p class=\"erreur\" id=\"erreur-' + cle + '\" role=\"alert\">' + message + \"</p>\";\n    }\n\n    function vueAccueil() {\n      return \"<h2>Bienvenue</h2>\" +\n        \"<p>Trois heures pour écrire votre première page web.</p>\" +\n        \"<h3>Inscrits à l'atelier</h3>\" +\n        '<div id=\"zone-liste\">' + vueListe() + \"</div>\" +\n        '<p><label for=\"panne\"><input type=\"checkbox\" id=\"panne\"' +\n        (etat.panneSimulee ? \" checked\" : \"\") + \"> Simuler une panne du service</label></p>\";\n    }\n\n    function vueListe() {\n      if (etat.statutListe === \"chargement\") {\n        return '<p class=\"etat\" role=\"status\">Chargement des inscrits…</p>';\n      }\n      if (etat.statutListe === \"erreur\") {\n        // TODO (parallèle : état d'erreur d'un effet) : message avec\n        // rôle d'alerte + bouton « Réessayer » dont le clic rappelle\n        // chargerInscrits().\n        return \"\";\n      }\n      if (etat.statutListe === \"vide\") {\n        // TODO : phrase de relance + lien vers #/inscription.\n        return \"\";\n      }\n      // TODO : liste ul.inscrits, un li par personne, nom et courriel\n      // séparés par un tiret.\n      return \"\";\n    }\n\n    function vueProgramme() {\n      return \"<h2>Programme de la journée</h2>\" +\n        \"<ol><li>14 h 00 — Accueil et prise en main</li>\" +\n        \"<li>14 h 30 — Titres, listes, images et liens</li>\" +\n        \"<li>16 h 30 — Écriture d'une page complète</li></ol>\";\n    }\n\n    function vueInscription() {\n      var envoi = etat.statutEnvoi;\n      return \"<h2>Inscription</h2>\" +\n        '<form id=\"formulaire\" novalidate>' +\n          (envoi === \"succes\" ? '<p class=\"succes\" role=\"status\">Votre inscription est enregistrée.</p>' : \"\") +\n          (envoi === \"echec\" && etat.erreurs.global ? '<p class=\"erreur\" role=\"alert\">' + etat.erreurs.global + \"</p>\" : \"\") +\n          '<label for=\"nom\">Nom complet</label>' +\n          '<input id=\"nom\" name=\"nom\" type=\"text\" autocomplete=\"name\" value=\"' + etat.valeurs.nom + '\"' +\n            (etat.erreurs.nom ? ' aria-invalid=\"true\" aria-describedby=\"erreur-nom\"' : \"\") + \">\" +\n          echecHTML(\"nom\") +\n          '<label for=\"courriel\">Adresse électronique</label>' +\n          '<input id=\"courriel\" name=\"courriel\" type=\"email\" autocomplete=\"email\" value=\"' + etat.valeurs.courriel + '\"' +\n            (etat.erreurs.courriel ? ' aria-invalid=\"true\" aria-describedby=\"erreur-courriel\"' : \"\") + \">\" +\n          echecHTML(\"courriel\") +\n          '<button type=\"submit\"' + (envoi === \"envoi\" ? \" disabled\" : \"\") + \">\" +\n            (envoi === \"envoi\" ? \"Envoi en cours…\" : \"Envoyer mon inscription\") +\n          \"</button>\" +\n        \"</form>\";\n    }\n\n    function vueIntrouvable() {\n      return \"<h2>Page introuvable</h2>\" +\n        \"<p>L'adresse demandée n'existe pas ou plus.</p>\" +\n        '<p><a href=\"#/\">Revenir à l\\'accueil</a></p>';\n    }\n\n    function rendre() {\n      var route = routeCourante();\n      var precedente = routePrecedente;\n      routePrecedente = route;\n      var contenu;\n      if (route === \"#/programme\") contenu = vueProgramme();\n      else if (route === \"#/inscription\") contenu = vueInscription();\n      else if (route === \"#/introuvable\") contenu = vueIntrouvable();\n      else contenu = vueAccueil();\n\n      app.innerHTML = contenu;\n\n      var liens = document.querySelectorAll(\"nav a\");\n      for (var i = 0; i < liens.length; i++) {\n        if (liens[i].getAttribute(\"data-route\") === route) {\n          liens[i].setAttribute(\"aria-current\", \"page\");\n        } else {\n          liens[i].removeAttribute(\"aria-current\");\n        }\n      }\n\n      if (route === \"#/\" && precedente !== \"#/\" && !chargementEnCours) chargerInscrits();\n      lierEvenements();\n    }\n\n    /* ============================================================\n       7. FORMULAIRE CONTRÔLÉ\n       Parallèle React : value + onChange sur chaque champ, la\n       valeur passant toujours par etat.valeurs avant l'écran.\n       ============================================================ */\n    function champChange(evenement) {\n      var champ = evenement.target.id;\n      etat.valeurs[champ] = evenement.target.value;\n      // TODO (parallèle : recalcul après soumission) : si le\n      // formulaire a déjà été validé une fois, recalculez\n      // etat.erreurs à chaque frappe pour effacer le message dès\n      // qu'il redevient juste.\n    }\n\n    function panneChange(evenement) {\n      etat.panneSimulee = evenement.target.checked;\n      // TODO : si l'écran affiche l'accueil, relancez chargerInscrits()\n      // pour que le nouvel état de la panne soit réellement éprouvé.\n    }\n\n    // TODO (parallèle : interception de onSubmit en React) : empêchez\n    // le rechargement par défaut, validez, puis basculez dans l'état\n    // \"envoi\" avant d'appeler postInscription(). En réussite, videz\n    // les champs et passez à \"succès\" ; en échec, passez à \"echec\"\n    // et conservez la saisie.\n    function soumettre(evenement) {\n      evenement.preventDefault();\n    }\n\n    function lierEvenements() {\n      var formulaire = document.getElementById(\"formulaire\");\n      if (formulaire && !formulaire.dataset.lie) {\n        formulaire.dataset.lie = \"oui\";\n        formulaire.addEventListener(\"submit\", soumettre);\n        var champs = formulaire.querySelectorAll(\"input\");\n        for (var i = 0; i < champs.length; i++) {\n          champs[i].addEventListener(\"input\", champChange);\n        }\n      }\n      var panne = document.getElementById(\"panne\");\n      if (panne && !panne.dataset.lie) {\n        panne.dataset.lie = \"oui\";\n        panne.addEventListener(\"change\", panneChange);\n      }\n      var reessayer = document.getElementById(\"reessayer\");\n      if (reessayer && !reessayer.dataset.lie) {\n        reessayer.dataset.lie = \"oui\";\n        reessayer.addEventListener(\"click\", chargerInscrits);\n      }\n    }\n\n    rendreEtLier();\n  </script>\n</body>\n</html>",
  "solution_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Atelier de la Médiathèque des Lilas — inscription</title>\n  <style>\n    :root { color-scheme: light; }\n    body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 0 auto; padding: 1.5rem; line-height: 1.5; color: #1b1b1f; }\n    nav ul { display: flex; gap: 1rem; list-style: none; padding: 0 0 0.75rem; margin: 0 0 1rem; border-bottom: 1px solid #d5d5dd; }\n    nav a { color: #2c2c86; text-decoration: none; }\n    nav a[aria-current=\"page\"] { font-weight: 700; text-decoration: underline; }\n    label { display: block; font-weight: 600; margin-top: 1rem; }\n    input { width: 100%; padding: 0.5rem; margin-top: 0.25rem; box-sizing: border-box; font: inherit; }\n    input[aria-invalid=\"true\"] { border: 2px solid #b00020; }\n    .erreur { color: #b00020; margin: 0.25rem 0 0; }\n    .succes { color: #0a6b2d; font-weight: 600; }\n    .etat { background: #f2f2f7; border-radius: 0.5rem; padding: 0.75rem 1rem; }\n    button { margin-top: 1rem; padding: 0.5rem 1rem; font: inherit; cursor: pointer; }\n    ul.inscrits { padding-left: 1.25rem; }\n    footer { margin-top: 2rem; border-top: 1px solid #d5d5dd; padding-top: 0.75rem; color: #55555f; font-size: 0.9rem; }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Atelier de la Médiathèque des Lilas</h1>\n    <nav aria-label=\"Navigation principale\">\n      <ul>\n        <li><a href=\"#/\" data-route=\"#/\">Accueil</a></li>\n        <li><a href=\"#/programme\" data-route=\"#/programme\">Programme</a></li>\n        <li><a href=\"#/inscription\" data-route=\"#/inscription\">Inscription</a></li>\n      </ul>\n    </nav>\n  </header>\n\n  <main id=\"app\"></main>\n\n  <footer>Inscription gratuite, samedi 18 octobre, salle 2.</footer>\n\n  <script>\n    /* 1. ÉTAT GLOBAL — l'équivalent de tous les useState du composant */\n    var etat = {\n      valeurs: { nom: \"\", courriel: \"\" },\n      erreurs: {},\n      statutEnvoi: \"repos\",\n      statutListe: \"chargement\",\n      inscrits: [],\n      messageListe: \"\",\n      panneSimulee: false\n    };\n\n    var inscritsEnBase = [\n      { id: 1, nom: \"Amina Belkacem\", courriel: \"amina@exemple.fr\" },\n      { id: 2, nom: \"Marc Lefèvre\", courriel: \"marc@exemple.fr\" }\n    ];\n\n    /* 2. MINI-CLIENT : promesses résolues localement, même forme qu'un appel réseau */\n    function getInscrits() {\n      return new Promise(function (resolve, reject) {\n        setTimeout(function () {\n          if (etat.panneSimulee) reject(new Error(\"Service indisponible\"));\n          else resolve(inscritsEnBase.slice());\n        }, 400);\n      });\n    }\n\n    function postInscription(donnees) {\n      return new Promise(function (resolve, reject) {\n        setTimeout(function () {\n          if (!donnees.courriel || donnees.courriel.indexOf(\"@\") === -1 ||\n              donnees.courriel.indexOf(\".\") === -1) {\n            reject(new Error(\"Adresse refusée par le service.\"));\n          } else {\n            var inscription = {\n              id: inscritsEnBase.length + 1,\n              nom: donnees.nom,\n              courriel: donnees.courriel\n            };\n            inscritsEnBase.push(inscription);\n            resolve(inscription);\n          }\n        }, 300);\n      });\n    }\n\n    /* 3. ROUTEUR PAR HASH — quatre routes, dont la page introuvable */\n    var routesConnues = [\"#/\", \"#/programme\", \"#/inscription\"];\n\n    function routeCourante() {\n      var hash = location.hash || \"#/\";\n      return routesConnues.indexOf(hash) === -1 ? \"#/introuvable\" : hash;\n    }\n\n    function allerA(hash) {\n      location.hash = hash;\n    }\n\n    /* 4. VALIDATION — fonction pure, une seule source de vérité */\n    function valider(valeurs) {\n      var erreurs = {};\n      if (valeurs.nom.trim().length < 2) {\n        erreurs.nom = \"Indiquez au moins deux caractères pour le nom.\";\n      }\n      if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(valeurs.courriel)) {\n        erreurs.courriel = \"Saisissez une adresse valide, par exemple prenom@domaine.fr.\";\n      }\n      return erreurs;\n    }\n\n    /* 5. CHARGEMENT « AU MONTAGE » — un seul tour, protégé par un drapeau */\n    var generation = 0;\n    var chargementEnCours = false;\n    var routePrecedente = null;\n\n    function chargerInscrits() {\n      generation += 1;\n      var courant = generation;\n      chargementEnCours = true;\n      etat.statutListe = \"chargement\";\n      rendre();\n\n      getInscrits().then(function (liste) {\n        if (courant !== generation) return;\n        chargementEnCours = false;\n        etat.inscrits = liste;\n        etat.statutListe = liste.length === 0 ? \"vide\" : \"succes\";\n        rendre();\n      }).catch(function (erreur) {\n        if (courant !== generation) return;\n        chargementEnCours = false;\n        etat.messageListe = erreur.message;\n        etat.statutListe = \"erreur\";\n        rendre();\n      });\n    }\n\n    /* 6. RENDU */\n    var app = document.getElementById(\"app\");\n\n    function echecHTML(cle) {\n      var message = etat.erreurs[cle];\n      if (!message) return \"\";\n      return '<p class=\"erreur\" id=\"erreur-' + cle + '\" role=\"alert\">' + message + \"</p>\";\n    }\n\n    function vueListe() {\n      if (etat.statutListe === \"chargement\") {\n        return '<p class=\"etat\" role=\"status\">Chargement des inscrits…</p>';\n      }\n      if (etat.statutListe === \"erreur\") {\n        return '<p class=\"erreur\" role=\"alert\">La liste n\\'a pas pu être chargée : ' +\n          etat.messageListe + \"</p>\" +\n          '<button type=\"button\" id=\"reessayer\">Réessayer</button>';\n      }\n      if (etat.statutListe === \"vide\") {\n        return '<p class=\"etat\">Aucune inscription pour le moment.</p>' +\n          '<p><a href=\"#/inscription\">S\\'inscrire à l\\'atelier</a></p>';\n      }\n      var html = '<ul class=\"inscrits\">';\n      for (var i = 0; i < etat.inscrits.length; i++) {\n        var personne = etat.inscrits[i];\n        html += \"<li>\" + personne.nom + \" — \" + personne.courriel + \"</li>\";\n      }\n      return html + \"</ul>\";\n    }\n\n    function vueAccueil() {\n      return \"<h2>Bienvenue</h2>\" +\n        \"<p>Trois heures pour écrire votre première page web.</p>\" +\n        \"<h3>Inscrits à l'atelier</h3>\" +\n        '<div id=\"zone-liste\">' + vueListe() + \"</div>\" +\n        '<p><label for=\"panne\"><input type=\"checkbox\" id=\"panne\"' +\n        (etat.panneSimulee ? \" checked\" : \"\") + \"> Simuler une panne du service</label></p>\";\n    }\n\n    function vueProgramme() {\n      return \"<h2>Programme de la journée</h2>\" +\n        \"<ol><li>14 h 00 — Accueil et prise en main</li>\" +\n        \"<li>14 h 30 — Titres, listes, images et liens</li>\" +\n        \"<li>16 h 30 — Écriture d'une page complète</li></ol>\";\n    }\n\n    function vueInscription() {\n      var envoi = etat.statutEnvoi;\n      var global = etat.erreurs.global;\n      return \"<h2>Inscription</h2>\" +\n        '<form id=\"formulaire\" novalidate>' +\n          (envoi === \"succes\"\n            ? '<p class=\"succes\" role=\"status\">Votre inscription est enregistrée. ' +\n              '<a href=\"#/\">Voir la liste des inscrits</a></p>'\n            : \"\") +\n          (global ? '<p class=\"erreur\" role=\"alert\">' + global + \"</p>\" : \"\") +\n          '<label for=\"nom\">Nom complet</label>' +\n          '<input id=\"nom\" name=\"nom\" type=\"text\" autocomplete=\"name\" value=\"' +\n            etat.valeurs.nom + '\"' +\n            (etat.erreurs.nom ? ' aria-invalid=\"true\" aria-describedby=\"erreur-nom\"' : \"\") +\n            (envoi === \"envoi\" ? \" disabled\" : \"\") + \">\" +\n          echecHTML(\"nom\") +\n          '<label for=\"courriel\">Adresse électronique</label>' +\n          '<input id=\"courriel\" name=\"courriel\" type=\"email\" autocomplete=\"email\" value=\"' +\n            etat.valeurs.courriel + '\"' +\n            (etat.erreurs.courriel ? ' aria-invalid=\"true\" aria-describedby=\"erreur-courriel\"' : \"\") +\n            (envoi === \"envoi\" ? \" disabled\" : \"\") + \">\" +\n          echecHTML(\"courriel\") +\n          '<button type=\"submit\"' + (envoi === \"envoi\" ? \" disabled\" : \"\") + \">\" +\n            (envoi === \"envoi\" ? \"Envoi en cours…\" : \"Envoyer mon inscription\") +\n          \"</button>\" +\n        \"</form>\";\n    }\n\n    function vueIntrouvable() {\n      return \"<h2>Page introuvable</h2>\" +\n        \"<p>L'adresse demandée n'existe pas ou plus.</p>\" +\n        '<p><a href=\"#/\">Revenir à l\\'accueil</a></p>';\n    }\n\n    function rendre() {\n      var route = routeCourante();\n      var precedente = routePrecedente;\n      routePrecedente = route;\n\n      var contenu;\n      if (route === \"#/programme\") contenu = vueProgramme();\n      else if (route === \"#/inscription\") contenu = vueInscription();\n      else if (route === \"#/introuvable\") contenu = vueIntrouvable();\n      else contenu = vueAccueil();\n\n      app.innerHTML = contenu;\n\n      var liens = document.querySelectorAll(\"nav a\");\n      for (var i = 0; i < liens.length; i++) {\n        if (liens[i].getAttribute(\"data-route\") === route) {\n          liens[i].setAttribute(\"aria-current\", \"page\");\n        } else {\n          liens[i].removeAttribute(\"aria-current\");\n        }\n      }\n\n      lierEvenements();\n\n      if (route === \"#/\" && precedente !== \"#/\" && !chargementEnCours) {\n        chargerInscrits();\n      }\n    }\n\n    /* 7. FORMULAIRE CONTRÔLÉ — chaque valeur passe par l'état */\n    function champChange(evenement) {\n      var champ = evenement.target.id;\n      etat.valeurs[champ] = evenement.target.value;\n      if (etat.statutEnvoi === \"echec\") {\n        etat.erreurs = valider(etat.valeurs);\n        mettreAJourErreurs();\n      }\n    }\n\n    function mettreAJourErreurs() {\n      [\"nom\", \"courriel\"].forEach(function (cle) {\n        var champ = document.getElementById(cle);\n        if (!champ) return;\n        var boite = document.getElementById(\"erreur-\" + cle);\n        if (etat.erreurs[cle]) {\n          champ.setAttribute(\"aria-invalid\", \"true\");\n          champ.setAttribute(\"aria-describedby\", \"erreur-\" + cle);\n          if (!boite) {\n            boite = document.createElement(\"p\");\n            boite.id = \"erreur-\" + cle;\n            boite.className = \"erreur\";\n            boite.setAttribute(\"role\", \"alert\");\n            champ.insertAdjacentElement(\"afterend\", boite);\n          }\n          boite.textContent = etat.erreurs[cle];\n        } else {\n          champ.removeAttribute(\"aria-invalid\");\n          champ.removeAttribute(\"aria-describedby\");\n          if (boite) boite.remove();\n        }\n      });\n    }\n\n    function panneChange(evenement) {\n      etat.panneSimulee = evenement.target.checked;\n      if (routeCourante() === \"#/\" && !chargementEnCours) chargerInscrits();\n    }\n\n    function soumettre(evenement) {\n      evenement.preventDefault();\n      if (chargementEnCours) return;\n\n      var trouvees = valider(etat.valeurs);\n      if (Object.keys(trouvees).length > 0) {\n        etat.erreurs = trouvees;\n        etat.erreurs.global = \"Le formulaire comporte des champs à corriger.\";\n        etat.statutEnvoi = \"echec\";\n        rendre();\n        var premier = document.getElementById(Object.keys(trouvees)[0]);\n        if (premier) premier.focus();\n        return;\n      }\n\n      etat.erreurs = {};\n      etat.statutEnvoi = \"envoi\";\n      chargementEnCours = true;\n      rendre();\n\n      postInscription(etat.valeurs).then(function () {\n        chargementEnCours = false;\n        etat.statutEnvoi = \"succes\";\n        etat.valeurs = { nom: \"\", courriel: \"\" };\n        etat.erreurs = {};\n        rendre();\n      }).catch(function (erreur) {\n        chargementEnCours = false;\n        etat.statutEnvoi = \"echec\";\n        etat.erreurs = { global: erreur.message };\n        rendre();\n      });\n    }\n\n    function lierEvenements() {\n      var formulaire = document.getElementById(\"formulaire\");\n      if (formulaire && !formulaire.dataset.lie) {\n        formulaire.dataset.lie = \"oui\";\n        formulaire.addEventListener(\"submit\", soumettre);\n        var champs = formulaire.querySelectorAll(\"input\");\n        for (var i = 0; i < champs.length; i++) {\n          champs[i].addEventListener(\"input\", champChange);\n        }\n      }\n      var panne = document.getElementById(\"panne\");\n      if (panne && !panne.dataset.lie) {\n        panne.dataset.lie = \"oui\";\n        panne.addEventListener(\"change\", panneChange);\n      }\n      var reessayer = document.getElementById(\"reessayer\");\n      if (reessayer && !reessayer.dataset.lie) {\n        reessayer.dataset.lie = \"oui\";\n        reessayer.addEventListener(\"click\", chargerInscrits);\n      }\n    }\n\n    function rendreEtLier() {\n      rendre();\n    }\n\n    window.addEventListener(\"hashchange\", rendreEtLier);\n    rendreEtLier();\n  </script>\n</body>\n</html>",
