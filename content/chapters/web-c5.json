  "starter_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Page atelier — aide-mémoire Git et npm</title>\n  <style>\n    :root {\n      --encre: #1b1f24;\n      --fond: #f4f6f9;\n      --cadre: #ffffff;\n      --accent: #10315c;\n      --accent-clair: #e7edf6;\n      --ok: #1c7c3c;\n      --gris: #5b6470;\n      --filet: #d4dae2;\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: var(--fond);\n      color: var(--encre);\n      font-family: Georgia, \"Times New Roman\", serif;\n      line-height: 1.55;\n    }\n    header {\n      background: var(--accent);\n      color: #ffffff;\n      padding: 2rem 1.25rem 1.5rem;\n    }\n    header h1 { margin: 0 0 0.4rem; font-size: 1.7rem; }\n    header p { margin: 0.3rem 0; max-width: 62ch; }\n    #progression {\n      display: inline-block;\n      margin-top: 0.9rem;\n      padding: 0.35rem 0.8rem;\n      background: rgba(255, 255, 255, 0.16);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n      border-radius: 999px;\n      font-size: 0.95rem;\n    }\n    main { max-width: 70rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }\n    section {\n      background: var(--cadre);\n      border: 1px solid var(--filet);\n      border-radius: 10px;\n      padding: 1.1rem 1.3rem 1.4rem;\n      margin-bottom: 1.4rem;\n    }\n    h2 {\n      margin: 0 0 0.8rem;\n      font-size: 1.2rem;\n      color: var(--accent);\n      border-bottom: 2px solid var(--accent-clair);\n      padding-bottom: 0.35rem;\n    }\n    h3 { margin: 1.1rem 0 0.4rem; font-size: 1.02rem; }\n    pre {\n      margin: 0;\n      padding: 0.9rem;\n      background: #f7f9fc;\n      border: 1px dashed var(--filet);\n      border-radius: 6px;\n      overflow-x: auto;\n      font-size: 0.9rem;\n      line-height: 1.45;\n    }\n    code { font-family: Consolas, \"Courier New\", monospace; font-size: 0.92rem; }\n    .commande {\n      display: inline-block;\n      padding: 0.15rem 0.45rem;\n      background: var(--accent-clair);\n      border-radius: 4px;\n      color: var(--accent);\n    }\n    .todo { color: #a15c00; background: #fff4e2; }\n    ol#etapes { list-style: none; margin: 0; padding: 0; counter-reset: etape; }\n    #etapes li {\n      counter-increment: etape;\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 0.6rem;\n      padding: 0.55rem 0.2rem;\n      border-bottom: 1px solid var(--filet);\n    }\n    #etapes li:last-child { border-bottom: 0; }\n    #etapes li::before {\n      content: counter(etape);\n      flex: 0 0 auto;\n      width: 1.7rem;\n      height: 1.7rem;\n      line-height: 1.7rem;\n      text-align: center;\n      border-radius: 50%;\n      background: var(--accent);\n      color: #ffffff;\n      font-size: 0.85rem;\n    }\n    #etapes label { flex: 1 1 20rem; cursor: pointer; }\n    #etapes input { margin-right: 0.5rem; transform: scale(1.15); accent-color: var(--ok); }\n    #etapes li:has(input:checked) label { color: var(--gris); text-decoration: line-through; }\n    footer {\n      max-width: 70rem;\n      margin: 0 auto;\n      padding: 0 1.25rem 3rem;\n      display: flex;\n      gap: 1rem;\n      align-items: center;\n      flex-wrap: wrap;\n    }\n    button {\n      font: inherit;\n      padding: 0.5rem 1.1rem;\n      border: 1px solid var(--accent);\n      border-radius: 6px;\n      background: var(--accent);\n      color: #ffffff;\n      cursor: pointer;\n    }\n    button.secondaire { background: #ffffff; color: var(--accent); }\n    #bilan { font-size: 0.95rem; color: var(--ok); font-weight: bold; }\n    .note { color: var(--gris); font-size: 0.92rem; }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Site de l'atelier — aide-mémoire Git et npm</h1>\n    <p>Ce brouillon affiche l'arbre du projet et la checklist des commandes à remplir. Cochez chaque étape au fur et à mesure : votre progression reste en mémoire, même après un rechargement de la page.</p>\n    <p id=\"progression\">0 étape sur 12</p>\n  </header>\n\n  <main>\n    <section id=\"arbre\">\n      <h2>Arbre du projet</h2>\n      <!-- TODO : afficher l'arbre complet du dossier site-atelier, exclusions et dossiers de sortie compris -->\n      <pre id=\"arbre-projet\">site-atelier/\n|-- .gitignore\n|-- package.json\n<!-- TODO : compléter les branches public/, src/ et scripts/ --></pre>\n      <p class=\"note\">Le dossier des dépendances installées et le dossier de sortie ne figurent jamais dans cet arbre versionné.</p>\n    </section>\n\n    <section id=\"checklist\">\n      <h2>Checklist des commandes</h2>\n      <p class=\"note\">Chaque ligne associe une étape du scénario à la commande exacte à taper dans le terminal.</p>\n      <ol id=\"etapes\">\n        <li>\n          <label for=\"etape-1\">Initialiser le dépôt local</label>\n          <input type=\"checkbox\" id=\"etape-1\" data-cle=\"etape-1\">\n          <!-- TODO : remplacer le texte à compléter par la commande exacte -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-2\">Contrôler ce que Git va suivre</label>\n          <input type=\"checkbox\" id=\"etape-2\" data-cle=\"etape-2\">\n          <!-- TODO : la commande d'état, à exécuter avant et après chaque opération -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-3\">Vérifier que le dossier des dépendances est bien exclu</label>\n          <input type=\"checkbox\" id=\"etape-3\" data-cle=\"etape-3\">\n          <!-- TODO : la commande qui interroge la liste des exclusions -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-4\">Ajouter tous les fichiers à l'index</label>\n          <input type=\"checkbox\" id=\"etape-4\" data-cle=\"etape-4\">\n          <!-- TODO : l'ajout de l'ensemble du dossier -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-5\">Créer la première capture avec un message explicite</label>\n          <input type=\"checkbox\" id=\"etape-5\" data-cle=\"etape-5\">\n          <!-- TODO : le commit initial, guillemets compris -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-6\">Ouvrir la branche du formulaire</label>\n          <input type=\"checkbox\" id=\"etape-6\" data-cle=\"etape-6\">\n          <!-- TODO : la commande qui crée et rejoint la branche en une passe -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-7\">Revenir sur la branche principale</label>\n          <input type=\"checkbox\" id=\"etape-7\" data-cle=\"etape-7\">\n          <!-- TODO : la commande de bascule, sans création -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-8\">Fusionner puis résoudre le conflit à la main</label>\n          <input type=\"checkbox\" id=\"etape-8\" data-cle=\"etape-8\">\n          <!-- TODO : la commande de fusion qui déclenche le conflit -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-9\">Connecter le serveur distant et pousser la branche</label>\n          <input type=\"checkbox\" id=\"etape-9\" data-cle=\"etape-9\">\n          <!-- TODO : la poussée qui établit le lien avec le distant -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-10\">Initialiser la déclaration npm</label>\n          <input type=\"checkbox\" id=\"etape-10\" data-cle=\"etape-10\">\n          <!-- TODO : l'initialisation non interactive -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-11\">Installer un outil de développement</label>\n          <input type=\"checkbox\" id=\"etape-11\" data-cle=\"etape-11\">\n          <!-- TODO : l'installation qui classe le paquet avec les outils -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n        <li>\n          <label for=\"etape-12\">Démarrer le serveur local puis construire le site</label>\n          <input type=\"checkbox\" id=\"etape-12\" data-cle=\"etape-12\">\n          <!-- TODO : les deux commandes du package.json, séparées par une esperluette -->\n          <code class=\"commande todo\">à compléter</code>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"conflit\">\n      <h2>En cas de conflit</h2>\n      <ol>\n        <li>Consulter l'état pour connaître les fichiers en conflit.</li>\n        <li>Ouvrir chaque fichier et lire les trois zones délimitées par les marqueurs.</li>\n        <li>Supprimer les marqueurs en conservant le texte voulu, puis relire en entier.</li>\n        <li>Ajouter le fichier résolu à l'index.</li>\n        <li>Valider la fusion, puis vérifier le graphe de l'historique.</li>\n      </ol>\n      <pre>&lt;&lt;&lt;&lt;&lt;&lt;&lt; HEAD\nvotre version\n=======\nversion de l'autre branche\n&gt;&gt;&gt;&gt;&gt;&gt;&gt; feature-formulaire</pre>\n    </section>\n  </main>\n\n  <footer>\n    <button type=\"button\" id=\"reinitialiser\" class=\"secondaire\">Réinitialiser la checklist</button>\n    <span id=\"bilan\"></span>\n  </footer>\n\n  <script>\n    (function () {\n      var CLE = \"atelier-etapes\";\n      var cases = Array.prototype.slice.call(document.querySelectorAll(\"#etapes input[type=checkbox]\"));\n      var etat = {};\n\n      // Le stockage local peut être indisponible : on bascule alors sur la mémoire vive.\n      function lire() {\n        try {\n          return JSON.parse(window.localStorage.getItem(CLE) || \"{}\");\n        } catch (erreur) {\n          return etat;\n        }\n      }\n\n      function ecrire(valeur) {\n        etat = valeur;\n        try {\n          window.localStorage.setItem(CLE, JSON.stringify(valeur));\n        } catch (erreur) {\n          /* stockage local indisponible : la session reste en mémoire */\n        }\n      }\n\n      function rafraichir() {\n        var cochees = cases.filter(function (c) { return c.checked; }).length;\n        document.getElementById(\"progression\").textContent = cochees + \" étape sur \" + cases.length;\n        // TODO : afficher un message de félicitations dans #bilan quand toutes les cases sont cochées\n      }\n\n      etat = lire();\n      cases.forEach(function (c) {\n        c.checked = Boolean(etat[c.dataset.cle]);\n        c.addEventListener(\"change\", function () {\n          etat[c.dataset.cle] = c.checked;\n          ecrire(etat);\n          rafraichir();\n        });\n      });\n\n      document.getElementById(\"reinitialiser\").addEventListener(\"click\", function () {\n        ecrire({});\n        cases.forEach(function (c) { c.checked = false; });\n        document.getElementById(\"bilan\").textContent = \"\";\n        rafraichir();\n      });\n\n      rafraichir();\n    })();\n  </script>\n</body>\n</html>\n",
  "solution_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Page atelier — aide-mémoire Git et npm</title>\n  <style>\n    :root {\n      --encre: #1b1f24;\n      --fond: #f4f6f9;\n      --cadre: #ffffff;\n      --accent: #10315c;\n      --accent-clair: #e7edf6;\n      --ok: #1c7c3c;\n      --gris: #5b6470;\n      --filet: #d4dae2;\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      background: var(--fond);\n      color: var(--encre);\n      font-family: Georgia, \"Times New Roman\", serif;\n      line-height: 1.55;\n    }\n    header {\n      background: var(--accent);\n      color: #ffffff;\n      padding: 2rem 1.25rem 1.5rem;\n    }\n    header h1 { margin: 0 0 0.4rem; font-size: 1.7rem; }\n    header p { margin: 0.3rem 0; max-width: 62ch; }\n    #progression {\n      display: inline-block;\n      margin-top: 0.9rem;\n      padding: 0.35rem 0.8rem;\n      background: rgba(255, 255, 255, 0.16);\n      border: 1px solid rgba(255, 255, 255, 0.4);\n      border-radius: 999px;\n      font-size: 0.95rem;\n    }\n    main { max-width: 70rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }\n    section {\n      background: var(--cadre);\n      border: 1px solid var(--filet);\n      border-radius: 10px;\n      padding: 1.1rem 1.3rem 1.4rem;\n      margin-bottom: 1.4rem;\n    }\n    h2 {\n      margin: 0 0 0.8rem;\n      font-size: 1.2rem;\n      color: var(--accent);\n      border-bottom: 2px solid var(--accent-clair);\n      padding-bottom: 0.35rem;\n    }\n    h3 { margin: 1.1rem 0 0.4rem; font-size: 1.02rem; }\n    pre {\n      margin: 0;\n      padding: 0.9rem;\n      background: #f7f9fc;\n      border: 1px dashed var(--filet);\n      border-radius: 6px;\n      overflow-x: auto;\n      font-size: 0.9rem;\n      line-height: 1.45;\n    }\n    code { font-family: Consolas, \"Courier New\", monospace; font-size: 0.92rem; }\n    .commande {\n      display: inline-block;\n      padding: 0.15rem 0.45rem;\n      background: var(--accent-clair);\n      border-radius: 4px;\n      color: var(--accent);\n    }\n    .todo { color: #a15c00; background: #fff4e2; }\n    ol#etapes { list-style: none; margin: 0; padding: 0; counter-reset: etape; }\n    #etapes li {\n      counter-increment: etape;\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 0.6rem;\n      padding: 0.55rem 0.2rem;\n      border-bottom: 1px solid var(--filet);\n    }\n    #etapes li:last-child { border-bottom: 0; }\n    #etapes li::before {\n      content: counter(etape);\n      flex: 0 0 auto;\n      width: 1.7rem;\n      height: 1.7rem;\n      line-height: 1.7rem;\n      text-align: center;\n      border-radius: 50%;\n      background: var(--accent);\n      color: #ffffff;\n      font-size: 0.85rem;\n    }\n    #etapes label { flex: 1 1 20rem; cursor: pointer; }\n    #etapes input { margin-right: 0.5rem; transform: scale(1.15); accent-color: var(--ok); }\n    #etapes li:has(input:checked) label { color: var(--gris); text-decoration: line-through; }\n    footer {\n      max-width: 70rem;\n      margin: 0 auto;\n      padding: 0 1.25rem 3rem;\n      display: flex;\n      gap: 1rem;\n      align-items: center;\n      flex-wrap: wrap;\n    }\n    button {\n      font: inherit;\n      padding: 0.5rem 1.1rem;\n      border: 1px solid var(--accent);\n      border-radius: 6px;\n      background: var(--accent);\n      color: #ffffff;\n      cursor: pointer;\n    }\n    button.secondaire { background: #ffffff; color: var(--accent); }\n    #bilan { font-size: 0.95rem; color: var(--ok); font-weight: bold; }\n    .note { color: var(--gris); font-size: 0.92rem; }\n  </style>\n</head>\n<body>\n  <header>\n    <h1>Site de l'atelier — aide-mémoire Git et npm</h1>\n    <p>Cette page affiche l'arbre du projet et la checklist des commandes de l'exercice. Cochez chaque étape au fur et à mesure : votre progression reste en mémoire, même après un rechargement de la page.</p>\n    <p id=\"progression\">0 étape sur 12</p>\n  </header>\n\n  <main>\n    <section id=\"arbre\">\n      <h2>Arbre du projet</h2>\n      <pre id=\"arbre-projet\">site-atelier/\n|-- .gitignore          exclusions versionnées\n|-- package.json        dépendances et commandes automatiques\n|-- package-lock.json   résolution exacte, versionnée elle aussi\n|-- README.md           présentation du projet\n|-- public/             ce qui part sur le serveur\n|   |-- index.html      page d'accueil\n|   |-- atelier.html    page de l'événement\n|   |-- styles.css      feuille de style publiée\n|   |-- script.js       interactions publiées\n|   \\-- images/\n|       \\-- logo.svg\n|-- src/                ce que vous écrivez et relisez\n|   |-- pages/\n|   |-- styles/\n|   \\-- scripts/\n\\-- scripts/            outils de construction\n    \\-- build.js        copie les sources vers public/</pre>\n      <p class=\"note\">Le dossier des dépendances installées et le dossier de sortie ne figurent jamais dans cet arbre versionné.</p>\n    </section>\n\n    <section id=\"checklist\">\n      <h2>Checklist des commandes</h2>\n      <p class=\"note\">Chaque ligne associe une étape du scénario à la commande exacte à taper dans le terminal.</p>\n      <ol id=\"etapes\">\n        <li>\n          <label for=\"etape-1\">Initialiser le dépôt local</label>\n          <input type=\"checkbox\" id=\"etape-1\" data-cle=\"etape-1\">\n          <code class=\"commande\">git init</code>\n        </li>\n        <li>\n          <label for=\"etape-2\">Contrôler ce que Git va suivre</label>\n          <input type=\"checkbox\" id=\"etape-2\" data-cle=\"etape-2\">\n          <code class=\"commande\">git status</code>\n        </li>\n        <li>\n          <label for=\"etape-3\">Vérifier que le dossier des dépendances est bien exclu</label>\n          <input type=\"checkbox\" id=\"etape-3\" data-cle=\"etape-3\">\n          <code class=\"commande\">git check-ignore node_modules/</code>\n        </li>\n        <li>\n          <label for=\"etape-4\">Ajouter tous les fichiers à l'index</label>\n          <input type=\"checkbox\" id=\"etape-4\" data-cle=\"etape-4\">\n          <code class=\"commande\">git add .</code>\n        </li>\n        <li>\n          <label for=\"etape-5\">Créer la première capture avec un message explicite</label>\n          <input type=\"checkbox\" id=\"etape-5\" data-cle=\"etape-5\">\n          <code class=\"commande\">git commit -m \"Version initiale du site de l'atelier\"</code>\n        </li>\n        <li>\n          <label for=\"etape-6\">Ouvrir la branche du formulaire</label>\n          <input type=\"checkbox\" id=\"etape-6\" data-cle=\"etape-6\">\n          <code class=\"commande\">git switch -c feature-formulaire</code>\n        </li>\n        <li>\n          <label for=\"etape-7\">Revenir sur la branche principale</label>\n          <input type=\"checkbox\" id=\"etape-7\" data-cle=\"etape-7\">\n          <code class=\"commande\">git switch main</code>\n        </li>\n        <li>\n          <label for=\"etape-8\">Fusionner puis résoudre le conflit à la main</label>\n          <input type=\"checkbox\" id=\"etape-8\" data-cle=\"etape-8\">\n          <code class=\"commande\">git merge feature-formulaire</code>\n          <code class=\"commande\">git add atelier.html</code>\n          <code class=\"commande\">git commit -m \"Fusion du formulaire d'inscription\"</code>\n        </li>\n        <li>\n          <label for=\"etape-9\">Connecter le serveur distant et pousser la branche</label>\n          <input type=\"checkbox\" id=\"etape-9\" data-cle=\"etape-9\">\n          <code class=\"commande\">git remote add origin https://github.com/camille/site-atelier.git</code>\n          <code class=\"commande\">git push -u origin main</code>\n        </li>\n        <li>\n          <label for=\"etape-10\">Initialiser la déclaration npm</label>\n          <input type=\"checkbox\" id=\"etape-10\" data-cle=\"etape-10\">\n          <code class=\"commande\">npm init -y</code>\n        </li>\n        <li>\n          <label for=\"etape-11\">Installer un outil de développement</label>\n          <input type=\"checkbox\" id=\"etape-11\" data-cle=\"etape-11\">\n          <code class=\"commande\">npm install --save-dev serveur-local</code>\n        </li>\n        <li>\n          <label for=\"etape-12\">Démarrer le serveur local puis construire le site</label>\n          <input type=\"checkbox\" id=\"etape-12\" data-cle=\"etape-12\">\n          <code class=\"commande\">npm start</code>\n          <code class=\"commande\">npm run build</code>\n        </li>\n      </ol>\n    </section>\n\n    <section id=\"conflit\">\n      <h2>En cas de conflit</h2>\n      <ol>\n        <li>Consulter l'état pour connaître les fichiers en conflit.</li>\n        <li>Ouvrir chaque fichier et lire les trois zones délimitées par les marqueurs.</li>\n        <li>Supprimer les marqueurs en conservant le texte voulu, puis relire en entier.</li>\n        <li>Ajouter le fichier résolu à l'index.</li>\n        <li>Valider la fusion, puis vérifier le graphe de l'historique.</li>\n      </ol>\n      <pre>&lt;&lt;&lt;&lt;&lt;&lt;&lt; HEAD\nvotre version\n=======\nversion de l'autre branche\n&gt;&gt;&gt;&gt;&gt;&gt;&gt; feature-formulaire</pre>\n    </section>\n  </main>\n\n  <footer>\n    <button type=\"button\" id=\"reinitialiser\" class=\"secondaire\">Réinitialiser la checklist</button>\n    <span id=\"bilan\"></span>\n  </footer>\n\n  <script>\n    (function () {\n      var CLE = \"atelier-etapes\";\n      var cases = Array.prototype.slice.call(document.querySelectorAll(\"#etapes input[type=checkbox]\"));\n      var etat = {};\n\n      // Le stockage local peut être indisponible : on bascule alors sur la mémoire vive.\n      function lire() {\n        try {\n          return JSON.parse(window.localStorage.getItem(CLE) || \"{}\");\n        } catch (erreur) {\n          return etat;\n        }\n      }\n\n      function ecrire(valeur) {\n        etat = valeur;\n        try {\n          window.localStorage.setItem(CLE, JSON.stringify(valeur));\n        } catch (erreur) {\n          /* stockage local indisponible : la session reste en mémoire */\n        }\n      }\n\n      function rafraichir() {\n        var cochees = cases.filter(function (c) { return c.checked; }).length;\n        document.getElementById(\"progression\").textContent = cochees + \" étape sur \" + cases.length;\n        var bilan = document.getElementById(\"bilan\");\n        if (cochees === cases.length) {\n          bilan.textContent = \"Dépôt versionné, conflit résolu et projet outillé : le site de l'atelier est prêt à être poussé.\";\n        } else {\n          bilan.textContent = \"\";\n        }\n      }\n\n      etat = lire();\n      cases.forEach(function (c) {\n        c.checked = Boolean(etat[c.dataset.cle]);\n        c.addEventListener(\"change\", function () {\n          etat[c.dataset.cle] = c.checked;\n          ecrire(etat);\n          rafraichir();\n        });\n      });\n\n      document.getElementById(\"reinitialiser\").addEventListener(\"click\", function () {\n        ecrire({});\n        cases.forEach(function (c) { c.checked = false; });\n        document.getElementById(\"bilan\").textContent = \"\";\n        rafraichir();\n      });\n\n      rafraichir();\n    })();\n  </script>\n</body>\n</html>\n",
