  "starter_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n  <!-- TODO 1 : titre d'onglet unique pour cette page (environ 55 caractères) -->\n  <title></title>\n\n  <!-- TODO 2 : description unique, rédigée à la main (environ 150 caractères) -->\n  <meta name=\"description\" content=\"\">\n\n  <!-- TODO 3 : adresse canonique en protocole sécurisé, sans barre finale -->\n  <link rel=\"canonical\" href=\"\">\n\n  <!-- TODO 4 : icône du site -->\n\n  <!-- TODO 5 : métadonnées de partage og:type, og:locale, og:title,\n       og:description, og:url, og:image (1200 x 630), og:image:width,\n       og:image:height -->\n\n  <style>\n    body { font-family: system-ui, sans-serif; color: #9a9aab; background: #ffffff; line-height: 1.6; margin: 0; }\n    main { max-width: 44rem; margin: 0 auto; padding: 1rem; }\n    #checklist label { display: block; padding: 0.35rem 0; }\n    /* TODO 6 : corrigez le contraste du texte et ajoutez un indicateur\n       de focus net pour les liens, les boutons et les champs */\n  </style>\n</head>\n<body>\n  <header>\n    <img src=\"images/logo.svg\" alt=\"Médiathèque des Lilas, retour à l'accueil\" width=\"160\" height=\"48\">\n    <h1>Ateliers numériques de la Médiathèque des Lilas</h1>\n  </header>\n\n  <main>\n    <section>\n      <h2>Checklist de mise en production</h2>\n      <p>Cochez chaque ligne au fur et à mesure : l'état est conservé dans votre navigateur.</p>\n\n      <figure>\n        <!-- TODO 7 : déclarez width et height, puis ajoutez loading=\"lazy\" -->\n        <img src=\"images/atelier-960.webp\" alt=\"Douze participants devant un écran de projection\">\n        <figcaption>Atelier précédent, salle informatique.</figcaption>\n      </figure>\n\n      <ul id=\"checklist\">\n        <li><label><input type=\"checkbox\" data-cle=\"metadonnees\"> Métadonnées complètes dans le head</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"description\"> Description unique pour cette page</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"opengraph\"> Open Graph avec image 1200 x 630</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"images\"> Images dimensionnées et chargement différé</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"accessibilite\"> Contrastes suffisants et focus visible</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"robots\"> robots.txt et plan du site à la racine</label></li>\n      </ul>\n\n      <p id=\"etat\" role=\"status\">0 point sur 6</p>\n\n      <!-- TODO 8 : décrivez ici vos étapes de déploiement et votre vérification -->\n      <pre id=\"deploiement\">\nÉtapes de déploiement :\n\n\nVérification post-déploiement :\n      </pre>\n    </section>\n  </main>\n\n  <footer>\n    <p>© 2026 Médiathèque des Lilas — <a href=\"mentions.html\">Mentions légales</a></p>\n  </footer>\n\n  <script>\n    // TODO 9 : au chargement, lisez l'enregistrement dans localStorage\n    //          et cochez les cases correspondantes (clé : 'livraison-atelier')\n    // TODO 10 : à chaque changement, enregistrez l'objet { cle: booleen }\n    //           dans localStorage puis mettez à jour le compteur #etat\n  </script>\n</body>\n</html>",
  "solution_code": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n  <title>Ateliers numériques — Médiathèque des Lilas</title>\n  <meta name=\"description\" content=\"Ateliers gratuits de prise en main de l'ordinateur et du web, chaque samedi à la Médiathèque des Lilas. Inscription en ligne.\">\n  <link rel=\"canonical\" href=\"https://mediatheque-des-lilas.example/ateliers/\">\n  <link rel=\"icon\" href=\"images/logo.svg\" type=\"image/svg+xml\">\n\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:locale\" content=\"fr_FR\">\n  <meta property=\"og:site_name\" content=\"Médiathèque des Lilas\">\n  <meta property=\"og:title\" content=\"Ateliers numériques — Médiathèque des Lilas\">\n  <meta property=\"og:description\" content=\"Trois heures pour écrire sa première page web, en accès gratuit.\">\n  <meta property=\"og:url\" content=\"https://mediatheque-des-lilas.example/ateliers/\">\n  <meta property=\"og:image\" content=\"https://mediatheque-des-lilas.example/images/affiche-atelier.webp\">\n  <meta property=\"og:image:width\" content=\"1200\">\n  <meta property=\"og:image:height\" content=\"630\">\n\n  <style>\n    body { font-family: system-ui, sans-serif; color: #1a1a2e; background: #ffffff; line-height: 1.6; margin: 0; }\n    main { max-width: 44rem; margin: 0 auto; padding: 1rem; }\n    #checklist label { display: block; padding: 0.35rem 0; }\n    a:focus-visible, input:focus-visible, button:focus-visible { outline: 3px solid #e07a00; outline-offset: 2px; }\n    #deploiement { background: #f2f4f7; padding: 0.75rem; white-space: pre-wrap; }\n  </style>\n</head>\n<body>\n  <header>\n    <img src=\"images/logo.svg\" alt=\"Médiathèque des Lilas, retour à l'accueil\" width=\"160\" height=\"48\">\n    <h1>Ateliers numériques de la Médiathèque des Lilas</h1>\n  </header>\n\n  <main>\n    <section>\n      <h2>Checklist de mise en production</h2>\n      <p>Cochez chaque ligne au fur et à mesure : l'état est conservé dans votre navigateur.</p>\n\n      <figure>\n        <img src=\"images/atelier-960.webp\" alt=\"Douze participants devant un écran de projection\" width=\"960\" height=\"600\" loading=\"lazy\" decoding=\"async\">\n        <figcaption>Atelier précédent, salle informatique.</figcaption>\n      </figure>\n\n      <ul id=\"checklist\">\n        <li><label><input type=\"checkbox\" data-cle=\"metadonnees\"> Métadonnées complètes dans le head</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"description\"> Description unique pour cette page</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"opengraph\"> Open Graph avec image 1200 x 630</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"images\"> Images dimensionnées et chargement différé</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"accessibilite\"> Contrastes suffisants et focus visible</label></li>\n        <li><label><input type=\"checkbox\" data-cle=\"robots\"> robots.txt et plan du site à la racine</label></li>\n      </ul>\n\n      <p id=\"etat\" role=\"status\">0 point sur 6</p>\n\n      <pre id=\"deploiement\">\nÉtapes de déploiement :\n1. Validation des modifications sur la branche principale du dépôt.\n2. Exécution de la commande de vérification, puis de la commande de publication.\n3. Publication automatique vers le dossier public de l'hébergeur.\n\nVérification post-déploiement :\nOuverture de l'adresse publique, parcours complet au clavier, écoute au lecteur\nd'écran, contrôle de robots.txt et du plan du site, mesure du poids de la page\net du contraste du texte.\n      </pre>\n    </section>\n  </main>\n\n  <footer>\n    <p>© 2026 Médiathèque des Lilas — <a href=\"mentions.html\">Mentions légales</a></p>\n  </footer>\n\n  <script>\n    var CLE = 'livraison-atelier';\n    var cases = Array.prototype.slice.call(document.querySelectorAll('#checklist input[type=\"checkbox\"]'));\n    var etat = document.getElementById('etat');\n\n    function majCompteur() {\n      var cochees = cases.filter(function (c) { return c.checked; }).length;\n      etat.textContent = cochees + ' point' + (cochees > 1 ? 's' : '') + ' sur ' + cases.length;\n    }\n\n    function charger() {\n      var sauvegarde = {};\n      try {\n        sauvegarde = JSON.parse(localStorage.getItem(CLE) || '{}');\n      } catch (erreur) {\n        sauvegarde = {};\n      }\n      cases.forEach(function (c) {\n        c.checked = sauvegarde[c.getAttribute('data-cle')] === true;\n      });\n      majCompteur();\n    }\n\n    function enregistrer() {\n      var donnees = {};\n      cases.forEach(function (c) {\n        donnees[c.getAttribute('data-cle')] = c.checked;\n      });\n      localStorage.setItem(CLE, JSON.stringify(donnees));\n      majCompteur();\n    }\n\n    cases.forEach(function (c) {\n      c.addEventListener('change', enregistrer);\n    });\n\n    charger();\n  </script>\n</body>\n</html>",
